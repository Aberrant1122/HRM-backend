# ===== APP CONFIGURATION =====
NODE_ENV=development
PORT=5001

# ===== JWT CONFIGURATION =====
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=30d
JWT_COOKIE_EXPIRES=30

# ===== DEVELOPMENT DATABASE =====
DEV_DB_USER=root
DEV_DB_PASSWORD=your_password
DEV_DB_NAME=hrm
DEV_DB_HOST=127.0.0.1
DEV_DB_PORT=3306

# ===== TEST DATABASE =====
TEST_DB_USER=root
TEST_DB_PASSWORD=your_test_password
TEST_DB_NAME=hrm_test
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306

# ===== PRODUCTION DATABASE =====
# These will be provided by your hosting platform (e.g., Railway, Heroku)
DB_USER=your_prod_user
DB_PASSWORD=your_prod_password
DB_NAME=your_prod_db
DB_HOST=your_prod_host
DB_PORT=3306

# ===== EMAIL CONFIGURATION =====
# Example for Gmail (use environment-specific email for production)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password

# ===== APP URLS =====
# For password reset links, email confirmations, etc.
APP_URL=http://localhost:3000
API_URL=http://localhost:5001

# ===== SSL/TLS CONFIGURATION =====
# For production, these are typically handled by your hosting platform
SSL_ENABLED=false
SSL_CERT_PATH=/path/to/ssl/cert.pem
SSL_KEY_PATH=/path/to/ssl/key.pem

# ===== RATE LIMITING =====
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX=100  # Max requests per window per IP
