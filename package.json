{
  "name": "hrm-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "echo \"Build completed - no database operations during build phase\"",
    "prestart": "npx sequelize-cli db:migrate --config=./config/config.js",
    "start": "npm run start:migrate",
    "start:migrate": "npx sequelize-cli db:migrate --config=./config/config.js && node server.js",
    "dev": "nodemon server.js",
    "migrate": "npx sequelize-cli db:migrate --config=./config/config.js",
    "migrate:undo": "npx sequelize-cli db:migrate:undo:all --config=./config/config.js",
    "seed": "npx sequelize-cli db:seed:all --config=./config/config.js",
    "seed:undo": "npx sequelize-cli db:seed:undo:all --config=./config/config.js",
    "test": "node --test tests/employee-access.test.js tests/integrity.test.js tests/runtime-safety.test.js tests/legacy-uploads.test.js tests/realtime-access.test.js tests/database-config.test.js tests/log-confidentiality.test.js tests/attendance-access.test.js tests/employee-account-summary.test.js tests/account-activity.test.js tests/cors-policy.test.js && node tests/payroll.test.js",
    "test:access": "node --test tests/employee-access.test.js",
    "test:integrity": "node --test tests/employee-access.test.js tests/integrity.test.js tests/runtime-safety.test.js tests/legacy-uploads.test.js tests/realtime-access.test.js tests/database-config.test.js tests/log-confidentiality.test.js tests/attendance-access.test.js tests/employee-account-summary.test.js tests/account-activity.test.js tests/cors-policy.test.js",
    "test:frontend-contract": "node --test tests/frontend-invite.test.js",
    "test:mysql9": "node --test tests/mysql9.integration.js",
    "test:realtime": "node --test tests/realtime-access.test.js",
    "test:history:mysql9": "node --test tests/employee-history.mysql9.test.js",
    "test:onboarding:mysql9": "node --test tests/onboarding.mysql9.test.js",
    "test:cors": "node --test tests/cors-policy.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayeshakhan-29/hrm-backend.git"
  },
  "author": "Ayesha",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ayeshakhan-29/hrm-backend/issues"
  },
  "homepage": "https://github.com/ayeshakhan-29/hrm-backend#readme",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.918.0",
    "@aws-sdk/s3-request-presigner": "^3.918.0",
    "audit": "^0.0.6",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-validator": "^7.2.1",
    "fix": "^0.0.6",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "memory-cache": "^0.2.0",
    "multer": "^2.0.2",
    "multer-s3": "^3.0.1",
    "mysql2": "^3.12.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.3",
    "nodemon": "^3.1.10",
    "npm": "^11.6.2",
    "pm2": "^6.0.14",
    "sequelize": "^6.37.5",
    "sequelize-cli": "^6.6.2",
    "socket.io": "^4.8.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/multer": "^2.0.0"
  },
  "engines": {
    "node": ">=18 <21"
  }
}
