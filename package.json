  "bugs": {
    "url": "https://github.com/ayeshakhan-29/hrm-backend/issues"
  },
  "homepage": "https://github.com/ayeshakhan-29/hrm-backend#readme",
  "description": "",
  "dependencies": {
    "audit": "^0.0.6",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "fix": "^0.0.6",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.12.0",
    "nodemailer": "^7.0.3",
    "nodemon": "^3.1.10",
    "npm": "^11.6.2",
    "sequelize": "^6.37.5",
    "sequelize-cli": "^6.6.2"
  },
  "devDependencies": {
    "@types/multer": "^2.0.0"
  },
  "engines": {
    "node": ">=18 <21"
  }
}
